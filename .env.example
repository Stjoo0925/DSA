# RUN_MODE
# 이 프로세스가 어떤 작업을 실행할지 결정합니다.
# keepalive:
#   - PostgreSQL에 접속합니다.
#   - 유휴 방지용 쿼리 3개를 순서대로 실행합니다.
#   - 3개 쿼리가 모두 실패한 경우에만 카카오워크 알림을 보냅니다.
# daily-report:
#   - 전일 JSONL 로그 파일을 읽습니다.
#   - 성공/실패 건수를 집계합니다.
#   - 카카오워크로 일일 보고를 보냅니다.
RUN_MODE=keepalive

# DATABASE_URL
# 배치 프로그램이 사용할 PostgreSQL 접속 문자열입니다.
# 아래 값은 예시이므로 실제 운영에서는 가비아 DB 접속 문자열로 교체해야 합니다.
# 예시 형식:
# postgresql://username:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# KAKAOWORK_WEBHOOK_URL
# 카카오워크 Incoming Webhook URL입니다.
# 장애 알림과 일일 보고가 모두 이 주소로 전송됩니다.
KAKAOWORK_WEBHOOK_URL=https://example.com/webhook

# APP_TIMEZONE
# 날짜 계산에 사용할 기준 타임존입니다.
# 이 값은 아래 항목에 영향을 줍니다.
# - 일일 보고에서 전일 범위를 계산하는 기준
# - 알림/보고 메시지에 표시되는 시각
# 한국시간 기준 운영이면 Asia/Seoul 사용을 권장합니다.
APP_TIMEZONE=Asia/Seoul

# LOG_DIR
# 날짜별 JSONL 로그 파일을 저장할 디렉터리입니다.
# 예시 생성 파일:
# ./logs/2026-03-26.jsonl
LOG_DIR=./logs

# QUERY_TIMEOUT_SECONDS
# DB 접속 및 쿼리 실행 1회에 적용할 타임아웃(초)입니다.
# DB 호출은 context timeout을 사용하므로 연결과 쿼리 실행 모두 이 값의 영향을 받습니다.
# 현재 운영 정책: 5초
QUERY_TIMEOUT_SECONDS=5

# HTTP_TIMEOUT_SECONDS
# 카카오워크 웹훅 HTTP 요청 1회에 적용할 타임아웃(초)입니다.
# 현재 운영 정책: 5초
HTTP_TIMEOUT_SECONDS=5

# MAX_RETRY_COUNT
# 첫 실패 이후 추가로 재시도할 횟수입니다.
# 0 = 최초 1회만 실행
# 1 = 최초 실행 + 재시도 1회
# 현재 운영 정책: 1회 재시도
MAX_RETRY_COUNT=1

# LOG_RETENTION_DAYS
# 날짜별 JSONL 로그 파일 보관 일수입니다.
# 이 일수보다 오래된 로그 파일은 자동 삭제됩니다.
# 현재 운영 정책: 7일
LOG_RETENTION_DAYS=7

# DB_LABEL
# 카카오워크 메시지에 표시할 DB 식별용 이름입니다.
# 운영/스테이징을 구분할 수 있는 값으로 넣는 것이 좋습니다.
# 예시: gabiadb-prod, gabiadb-staging
DB_LABEL=gabiadb-prod
